# Flywheel client configuration — Livewire (client #1)
# Sourced by bash; no secrets; see clients/_template/client.env for docs.

# ── Identity ─────────────────────────────────────────────────────────────
CLIENT_SLUG="livewire"
CLIENT_DISPLAY_NAME="Livewire"

# ── GCP ──────────────────────────────────────────────────────────────────
GCP_PROJECT_ID="livewire-dw"
BQ_LOCATION="US"
ADMIN_USER="henry@getlivewire.com"

# ── Datasets ─────────────────────────────────────────────────────────────
DATASETS_RAW="raw_zoho raw_zohobilling raw_dtools raw_qbo"
DATASET_STAGING="staging"
DATASET_MARTS="marts"

# ── Service accounts ─────────────────────────────────────────────────────
SA_HERMES_READER="hermes-reader"
SA_INGEST_WRITER="ingest-writer"

# ── Labels ───────────────────────────────────────────────────────────────
LABEL_MANAGED_BY="flywheel"
LABEL_ENV="prod"

# ── Key handling (escape hatch only) ─────────────────────────────────────
KEY_DIR="${HOME}/.flywheel/keys/${CLIENT_SLUG}"

# ── Phase 2 (ingestion / WIF) ────────────────────────────────────────────
GITHUB_REPO="hfscdogg/flywheel-warehouse"
WIF_POOL="flywheel-github"

# ── Zoho Billing ─────────────────────────────────────────────────────────
# Org id for the Billing API header; also set as the ZOHO_BILLING_ORG_ID
# GitHub Actions variable for the ingest workflow.
# ZOHO_BILLING_ORG_ID is read from the environment, not from here.

# ── Phase 4 (agent endpoint) ─────────────────────────────────────────────
RUN_REGION="us-east4"                 # Cloud Run region for hermes-mcp
