# Flywheel client configuration — Livewire (client #1)
# Sourced by bash; no secrets; see clients/_template/client.env for docs.

# ── Identity ─────────────────────────────────────────────────────────────
CLIENT_SLUG="livewire"
CLIENT_DISPLAY_NAME="Livewire"

# ── GCP ──────────────────────────────────────────────────────────────────
GCP_PROJECT_ID="livewire-dw"
BQ_LOCATION="US"
ADMIN_USER="henry@getlivewire.com"

# ── Datasets ─────────────────────────────────────────────────────────────
DATASETS_RAW="raw_zoho raw_zohobilling raw_dtools raw_qbo raw_vendor raw_alarmdotcom raw_ga4"
DATASET_STAGING="staging"
DATASET_MARTS="marts"

# ── Service accounts ─────────────────────────────────────────────────────
SA_HERMES_READER="hermes-reader"
SA_INGEST_WRITER="ingest-writer"

# ── Labels ───────────────────────────────────────────────────────────────
LABEL_MANAGED_BY="flywheel"
LABEL_ENV="prod"

# ── Key handling (escape hatch only) ─────────────────────────────────────
KEY_DIR="${HOME}/.flywheel/keys/${CLIENT_SLUG}"

# ── Phase 2 (ingestion / WIF) ────────────────────────────────────────────
GITHUB_REPO="hfscdogg/flywheel-warehouse"
WIF_POOL="flywheel-github"

# ── Google Analytics 4 ───────────────────────────────────────────────────
# The GA4 property's own BigQuery export (property 285482813), written by
# Google into this project, daily tables events_YYYYMMDD from 2026-08-24.
# 01-datasets.sh reads it through the view raw_ga4.events; 03-iam.sh gives
# ingest-writer read access to it. hermes-reader never gets any.
GA4_EXPORT_DATASET="analytics_285482813"

# ── Zoho Billing ─────────────────────────────────────────────────────────
# Org id for the Billing API header; also set as the ZOHO_BILLING_ORG_ID
# GitHub Actions variable for the ingest workflow.
# ZOHO_BILLING_ORG_ID is read from the environment, not from here.

# ── Phase 4 (agent endpoint) ─────────────────────────────────────────────
RUN_REGION="us-east4"                 # Cloud Run region for hermes-mcp
# Tier 2b, chosen 2026-09-04: Hermes answers ad-hoc questions in Telegram,
# which needs row-grain staging, not just the six KPI summaries.
AGENT_SCOPE="wide"

# ── D-Tools Cloud API v2 (pipelines/dtools/v2.py) ─────────────────────────
# Per-environment values D-Tools issues; none is secret (the refresh token
# is, and lives in Secret Manager). The values in D-Tools' public docs are
# for their demo environment and will not work against production.
#DTOOLS_V2_TENANT_ID=""
#DTOOLS_V2_CLIENT_ID=""      # D-Tools' DirectAPI public client id
#DTOOLS_V2_SCOPE=""          # e.g. api://<app id>/access_as_user
#DTOOLS_V2_ACCOUNT_ID=""     # only if the service user reaches more than one account
#DTOOLS_V2_BASE_URL=""       # default https://api.d-tools.cloud/api/v2
