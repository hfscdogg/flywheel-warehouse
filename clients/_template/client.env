# Flywheel client configuration — TEMPLATE
#
# New client:
#   1. cp -r clients/_template clients/<slug>
#   2. Edit every CHANGEME below
#   3. ./scripts/setup.sh <slug>
#
# This file is sourced by bash (3.2-compatible: plain variables and
# space-separated strings only — no arrays). It contains no secrets and is
# committed to the repo as the record of the engagement.

# ── Identity ─────────────────────────────────────────────────────────────
# Slug: lowercase letters/digits/hyphens, starts with a letter. Must match
# the directory name. Used in GCP labels and key paths.
CLIENT_SLUG="CHANGEME-slug"
CLIENT_DISPLAY_NAME="CHANGEME Display Name"

# ── GCP ──────────────────────────────────────────────────────────────────
# Project IDs are globally unique across GCP; if your first choice is taken,
# pick another — only this line changes.
GCP_PROJECT_ID="CHANGEME-project-id"
# BigQuery location: "US" multi-region unless the client has residency needs
# (e.g. "us-east4", "EU").
BQ_LOCATION="US"
# Human owner. Gets serviceAccountTokenCreator on the reader SA so they can
# impersonate it (smoke tests, keyless agent auth).
ADMIN_USER="CHANGEME@example.com"

# ── Datasets (fixed names; the project is the namespace) ─────────────────
# One raw_<source> per source system, space-separated. Different sources for
# this client? Change the list — everything downstream is driven by it.
DATASETS_RAW="raw_zoho raw_zohobilling raw_dtools raw_qbo"
DATASET_STAGING="staging"
DATASET_MARTS="marts"

# ── Service accounts (short names; emails derived in scripts/lib/common.sh)
SA_HERMES_READER="hermes-reader"   # agents: read marts + run jobs, nothing else
SA_INGEST_WRITER="ingest-writer"   # pipelines: write raw, build staging/marts

# ── Labels (applied to every dataset; lowercase/digits/-/_ only) ─────────
LABEL_MANAGED_BY="flywheel"
LABEL_ENV="prod"
# common.sh composes: managed-by=$LABEL_MANAGED_BY client=$CLIENT_SLUG env=$LABEL_ENV

# ── Key handling (escape hatch only — impersonation is the default) ──────
# If a key is ever minted (scripts/04-agent-key.sh), it lands here. NEVER
# inside the repo.
KEY_DIR="${HOME}/.flywheel/keys/${CLIENT_SLUG}"

# ── Phase 2 (uncomment when setting up ingestion / WIF) ──────────────────
# GITHUB_REPO="CHANGEME-org/flywheel-warehouse"
# WIF_POOL="flywheel-github"

# ── Phase 4 (agent endpoint) ─────────────────────────────────────────────
# Cloud Run region for the hermes-mcp agent endpoint (scripts/07-hermes-endpoint.sh).
# RUN_REGION="us-east4"
